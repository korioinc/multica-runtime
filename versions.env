# Literal public build inputs. Values are data, never shell code.

# --- Controller base image ---
# Select the ABI 2 controller base by release version.
# Local builds may override the controller base with --base-image.
# Provider HOME package seeding and configured Codex skills require this base.
CONTROLLER_BASE_IMAGE_REF=ghcr.io/korioinc/multica-runtime-controller:0.3.44

# --- Debian OS packages ---
DEBIAN_SNAPSHOT=20260901T000000Z
DEBIAN_CODENAME=bookworm

# --- JavaScript: Node.js / Corepack ---
NODE_VERSION=26.7.0
COREPACK_VERSION=0.35.0

# --- PHP: runtime, Composer, and extensions ---
PHP_VERSION=8.5.9
COMPOSER_VERSION=2.10.2
MONGODB_PHP_EXTENSION_VERSION=2.3.3
PHPREDIS_VERSION=6.3.0
ZSTD_PHP_EXTENSION_VERSION=0.17.0

# --- Rust toolchain ---
RUST_VERSION=1.97.1

# --- Python: runtime, pipx, and uv ---
PYTHON_VERSION=3.11.2
PIPX_VERSION=1.1.0
UV_VERSION=0.12.3

# --- YAML and shell tools ---
YQ_VERSION=4.53.3
SHFMT_VERSION=3.13.1

# --- Git and GitHub tools ---
GH_VERSION=2.97.0
LEFTHOOK_VERSION=2.1.12

# --- Kubernetes tools ---
K9S_VERSION=0.51.0
KUBECTX_VERSION=0.11.0
KUBECTL_VERSION=1.36.3

# --- Cloud CLIs ---
AWS_CLI_VERSION=2.36.22
OCI_CLI_VERSION=3.90.2
GCLOUD_CLI_VERSION=580.0.0

# --- Multica CLI ---
MULTICA_CLI_VERSION=0.4.41

# --- OpenAI Codex ---
CODEX_VERSION=0.153.4

# --- Pi Coding Agent and packages ---
PI_VERSION=0.85.1
PI_MCP_ADAPTER_VERSION=2.32.1
PI_WEB_ACCESS_VERSION=0.28.0
PI_OPENAI_SERVICE_TIER_VERSION=0.1.4
PI_PONYTAIL_VERSION=4.9.0
PI_CACHE_OPTIMIZER_VERSION=2.8.7

# --- MCP servers ---
CODEBASE_MEMORY_MCP_VERSION=0.10.8
CHROME_DEVTOOLS_MCP_VERSION=1.9.0
