# Literal public build inputs. Values are data, never shell code.

# --- Controller base image ---
# Select the controller base by its pinned image reference.
# Local builds may override the controller base with --base-image.
# Image admission validates installed files without an adapter verification report.
CONTROLLER_BASE_IMAGE_REF=ghcr.io/korioinc/multica-runtime-controller:2.0.0

# --- Debian OS packages ---
DEBIAN_SNAPSHOT=20261007T082648Z
DEBIAN_CODENAME=bookworm

# --- Database CLIs: exact Debian package versions from the snapshot ---
# MySQL uses mariadb-client and mariadb-client-core; PostgreSQL uses its major-version client package.
MYSQL_CLI_VERSION=1:10.11.18-0+deb12u1
POSTGRESQL_CLI_VERSION=15.19-0+deb12u1
SQLITE_CLI_VERSION=3.40.1-2+deb12u2
REDIS_CLI_VERSION=5:7.0.15-1~deb12u10

# --- JavaScript: Node.js / Corepack ---
NODE_VERSION=26.10.0
COREPACK_VERSION=0.36.0

# --- PHP: runtime, Composer, and extensions ---
PHP_VERSION=8.5.11
COMPOSER_VERSION=2.10.3
MONGODB_PHP_EXTENSION_VERSION=2.5.3
PHPREDIS_VERSION=6.3.0
ZSTD_PHP_EXTENSION_VERSION=0.18.0

# --- Rust toolchain ---
RUST_VERSION=1.99.0

# --- Python: runtime, pipx, and uv ---
# Install upstream Python independently of Debian's system Python.
PYTHON_VERSION=3.14.8
PIPX_VERSION=1.17.11
UV_VERSION=0.12.23

# --- Search, YAML, and shell tools ---
FD_VERSION=10.5.0
YQ_VERSION=4.54.1
SHFMT_VERSION=3.14.1

# --- Git and GitHub tools ---
GH_VERSION=2.102.0
LEFTHOOK_VERSION=2.1.17

# --- Kubernetes tools ---
K9S_VERSION=0.51.0
KUBECTX_VERSION=0.11.0
KUBECTL_VERSION=1.37.1

# --- Cloud CLIs ---
AWS_CLI_VERSION=2.37.10
OCI_CLI_VERSION=3.94.2
GCLOUD_CLI_VERSION=588.0.0

# --- Multica CLI ---
MULTICA_CLI_VERSION=0.6.1

# --- OpenAI Codex ---
CODEX_VERSION=0.160.1

# --- Anthropic Claude Code ---
CLAUDE_VERSION=2.1.292

# --- Pi Coding Agent and packages ---
PI_VERSION=1.0.4
PI_MCP_ADAPTER_VERSION=5.1.0
PI_WEB_ACCESS_VERSION=0.37.0
PI_OPENAI_SERVICE_TIER_VERSION=0.1.4
PI_PONYTAIL_VERSION=4.13.0
PI_CACHE_OPTIMIZER_VERSION=2.8.21

# --- MCP servers ---
CODEBASE_MEMORY_MCP_VERSION=0.11.0

# --- Virtual desktop ---
GOOGLE_CHROME_VERSION=155.0.8059.39-1
OPEN_BROWSER_USE_VERSION=0.1.42
CUA_DRIVER_VERSION=0.34.0
